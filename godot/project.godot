; Engine configuration file.
; wallr: the Godot 4 port of the browser game.

config_version=5

[application]

config/name="wallr"
config/description="The wallbang shooter: 5v5 with bots. Original code, models, textures and sounds."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
Assets="*res://scripts/world/assets.gd"
Data="*res://scripts/core/data.gd"
Game="*res://scripts/core/game.gd"
Controls="*res://scripts/player/controls.gd"
Snd="*res://scripts/audio/snd.gd"
Models="*res://scripts/models/models.gd"
Arsenal="*res://scripts/weapons/arsenal.gd"
Ents="*res://scripts/world/ents.gd"
FX="*res://scripts/fx/fx.gd"
Grenades="*res://scripts/weapons/grenades.gd"
Items="*res://scripts/match/items.gd"
Bomb="*res://scripts/match/bomb.gd"
Match="*res://scripts/match/match.gd"
Nav="*res://scripts/bots/nav.gd"
Bots="*res://scripts/bots/bots.gd"
Tactics="*res://scripts/bots/tactics.gd"
Actors="*res://scripts/actors/actors.gd"
Viewmodel="*res://scripts/view/viewmodel.gd"
Profile="*res://scripts/meta/profile.gd"
Accounts="*res://scripts/meta/accounts.gd"
Admin="*res://scripts/meta/admin.gd"
Session="*res://scripts/meta/session.gd"
Net="*res://scripts/net/net.gd"
MenuCam="*res://scripts/meta/menu_cam.gd"
Gfx="*res://scripts/view/gfx.gd"
HUD="*res://scripts/ui/hud.gd"
Menus="*res://scripts/ui/menus.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=64
common/max_physics_steps_per_frame=8
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/default_filters/anisotropic_filtering_level=4

[importer_defaults]

texture={
"mipmaps/generate": true
}

[shader_globals]

world_fog={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

sky_pano={
"type": "sampler2D",
"value": ""
}

macro_tex={
"type": "sampler2D",
"value": ""
}

indirect_k={
"type": "float",
"value": 1.0
}

refl_k={
"type": "float",
"value": 1.0
}
